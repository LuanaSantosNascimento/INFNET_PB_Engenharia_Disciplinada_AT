<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="fileExtensions" value="java"/>
    </module>

    <module name="TreeWalker">
        <module name="PackageName"/><module name="TypeName"/><module name="MemberName"/>
        <module name="ParameterName"/><module name="LocalVariableName"/>

        <module name="AvoidStarImport"/><module name="UnusedImports"/><module name="RedundantImport"/>

        <module name="WhitespaceAround"/>
        <module name="LeftCurly"/><module name="RightCurly"/>
    </module>
</module>